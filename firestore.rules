rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOrgMember(orgId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
    
    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // Organizations and their subcollections
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isAuthenticated();
      allow update: if isOrgMember(orgId); // In a real app, check for 'admin' role inside org
      
      match /members/{memberId} {
        allow read: if isOrgMember(orgId) || (isAuthenticated() && request.auth.uid == memberId);
        allow write: if isOrgMember(orgId) || (isAuthenticated() && request.auth.uid == memberId);
      }
      
      match /leads/{leadId} {
        allow read, write: if isOrgMember(orgId);
      }
      
      match /opportunities/{opId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /clients/{clientId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /projects/{projectId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /tickets/{ticketId} {
        allow read, write: if isOrgMember(orgId);
      }
      
      match /tasks/{taskId} {
        allow read, write: if isOrgMember(orgId);
      }
    }
  }
}
